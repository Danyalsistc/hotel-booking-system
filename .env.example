# =============================================================================
#  Hotel Booking System - environment variable REFERENCE
#  ICT304 Capstone 2
# -----------------------------------------------------------------------------
#  READ THIS FIRST
#
#  This file is a REFERENCE LIST, not a configuration file that gets loaded.
#  config.php deliberately has no dotenv reader: adding one would mean pulling
#  in Composer and an external package, and this project is built to run on a
#  stock XAMPP install with no dependencies.
#
#  Copying this file to ".env" therefore changes NOTHING on its own. The values
#  below must be supplied to PHP as real environment variables - see
#  HOSTING.md for how to do that on Apache and on a typical managed host.
#
#  config.php reads each one through getenv() / $_ENV / $_SERVER and falls back
#  to the local XAMPP default when it is not set, which is why the project runs
#  out of the box on a marker's machine with none of these defined.
#
#  NEVER COMMIT A REAL .env. The .htaccess in this folder already blocks it
#  from the web twice over (dot-files are denied, and the ".env" extension is
#  denied), and .gitignore keeps it out of the repository - but the safest
#  secret is still one that was never written into the project folder at all.
# =============================================================================


# --- Database ----------------------------------------------------------------

# Hostname or IP of the MySQL/MariaDB server.
# Local XAMPP default: localhost
DB_HOST=localhost

# Port the database listens on.
# Local XAMPP default: 3306
DB_PORT=3306

# Schema name. Created by database.sql.
# Local XAMPP default: hotel_booking
DB_NAME=hotel_booking

# Database username.
# Local XAMPP default: root
#
# FOR PRODUCTION: do not use root. Create an account restricted to this one
# schema with only SELECT, INSERT, UPDATE and DELETE - the application never
# issues DDL at runtime, so it does not need CREATE, ALTER or DROP.
DB_USER=hotel_app

# Database password.
#
# Leave the real value OUT of this file. The local XAMPP default is an empty
# password, which is a factory setting rather than a secret; any deployment
# beyond localhost must set a strong one here through the hosting environment.
DB_PASS=

# --- Notes -------------------------------------------------------------------
#
# There is no APP_ENV / debug switch to set. config.php already keeps
# display_errors off and log_errors on unconditionally, so a database failure
# is written to the server error log and the visitor only ever sees a generic
# "service temporarily unavailable" page. That behaviour is the same locally
# and in production, which means the production path is the one being tested
# during development rather than a separate, untested branch.
